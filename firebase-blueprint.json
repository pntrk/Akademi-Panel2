{
  "entities": {
    "AppState": {
      "title": "AppState",
      "description": "The complete application state",
      "type": "object",
      "properties": {
        "students": { "type": "array" },
        "exams": { "type": "array" },
        "results": { "type": "array" },
        "budget": { "type": "object" },
        "examHalls": { "type": "array" },
        "leagueMentors": { "type": "object" },
        "leagueTeamPoints": { "type": "object" },
        "approvedTransfers": { "type": "array" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "AppState",
      "description": "User's application state"
    }
  }
}
