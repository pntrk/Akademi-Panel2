rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    match /schools/main {
      allow create: if request.auth != null && request.auth.token.email == 'kirklareliataturkortaokulu@gmail.com';
      
      allow read: if request.auth != null && (
        request.auth.token.email == 'kirklareliataturkortaokulu@gmail.com' ||
        (resource.data.admins != null && request.auth.token.email in resource.data.admins) ||
        (resource.data.teachers != null && request.auth.token.email in resource.data.teachers)
      );
      
      allow update: if request.auth != null && (
        request.auth.token.email == 'kirklareliataturkortaokulu@gmail.com' ||
        (resource.data.admins != null && request.auth.token.email in resource.data.admins)
      );
    }

    match /access_requests/{document=**} {
      allow read, write, delete: if request.auth != null;
    }
  }
}
